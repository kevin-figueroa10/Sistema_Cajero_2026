@{
    ViewData["Title"] = "Menú Principal";
}

<div class="container">
    <!-- Header del Banco -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="alert alert-primary text-center py-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; color: white;">
                <h2 class="mb-0">🏦 BANCO NEW SMART CAPITAL</h2>
                <p class="mb-0 small mt-2">Sistema Cajero Automático 2026</p>
            </div>
        </div>
    </div>

    <!-- Bienvenida -->
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="mb-2">
                👋 Bienvenido, <span class="text-primary">@Context.Session.GetString("Propietario")</span>
            </h1>
            <p class="text-muted">
                Tipo de Cuenta:
                <span class="badge badge-info badge-lg" style="padding: 8px 12px; font-size: 14px;">
                    @(Context.Session.GetString("TipoCuenta") ?? "Ahorro")
                </span>
            </p>
            <p class="text-muted">📌 Selecciona la operación que deseas realizar</p>
        </div>
    </div>

    <!-- Menú de opciones -->
    <div class="row" style="margin: 30px 0;">
        <!-- Consultar Saldo -->
        <div class="col-md-6 col-lg-4 mb-4">
            <a href="/Principal/ConsultarSaldo" class="card menu-item text-decoration-none h-100">
                <div class="card-body text-center py-5">
                    <div style="font-size: 48px; margin-bottom: 15px;">💰</div>
                    <h5 class="card-title">Consultar Saldo</h5>
                    <p class="card-text text-muted small">Ver tu saldo actual</p>
                </div>
            </a>
        </div>

        <!-- Realizar Depósito -->
        <div class="col-md-6 col-lg-4 mb-4">
            <a href="/Principal/Deposito" class="card menu-item text-decoration-none h-100">
                <div class="card-body text-center py-5">
                    <div style="font-size: 48px; margin-bottom: 15px;">📥</div>
                    <h5 class="card-title">Realizar Depósito</h5>
                    <p class="card-text text-muted small">Ingresar dinero</p>
                </div>
            </a>
        </div>

        <!-- Realizar Retiro -->
        <div class="col-md-6 col-lg-4 mb-4">
            <a href="/Principal/Retiro" class="card menu-item text-decoration-none h-100">
                <div class="card-body text-center py-5">
                    <div style="font-size: 48px; margin-bottom: 15px;">📤</div>
                    <h5 class="card-title">Realizar Retiro</h5>
                    <p class="card-text text-muted small">Sacar dinero</p>
                </div>
            </a>
        </div>

        <!-- Transferencia -->
        <div class="col-md-6 col-lg-4 mb-4">
            <a href="/Principal/Transferencia" class="card menu-item text-decoration-none h-100">
                <div class="card-body text-center py-5">
                    <div style="font-size: 48px; margin-bottom: 15px;">💸</div>
                    <h5 class="card-title">Transferencia</h5>
                    <p class="card-text text-muted small">Enviar dinero</p>
                </div>
            </a>
        </div>

        <!-- Historial -->
        <div class="col-md-6 col-lg-4 mb-4">
            <a href="/Principal/Historial" class="card menu-item text-decoration-none h-100">
                <div class="card-body text-center py-5">
                    <div style="font-size: 48px; margin-bottom: 15px;">📋</div>
                    <h5 class="card-title">Historial</h5>
                    <p class="card-text text-muted small">Ver transacciones</p>
                </div>
            </a>
        </div>

        <!-- Mi Cuenta -->
        <div class="col-md-6 col-lg-4 mb-4">
            <a href="/Principal/MiCuenta" class="card menu-item text-decoration-none h-100">
                <div class="card-body text-center py-5">
                    <div style="font-size: 48px; margin-bottom: 15px;">🪪</div>
                    <h5 class="card-title">Mi Cuenta</h5>
                    <p class="card-text text-muted small">Ver detalles</p>
                </div>
            </a>
        </div>

        <!-- Cambiar PIN -->
        <div class="col-md-6 col-lg-4 mb-4">
            <a href="/Principal/CambiarPIN" class="card menu-item text-decoration-none h-100">
                <div class="card-body text-center py-5">
                    <div style="font-size: 48px; margin-bottom: 15px;">🔐</div>
                    <h5 class="card-title">Cambiar PIN</h5>
                    <p class="card-text text-muted small">Cambiar seguridad</p>
                </div>
            </a>
        </div>
    </div>

    <!-- Botón de salida -->
    <div class="row mt-5">
        <div class="col-md-12">
            <a href="/Autenticacion/Logout" class="btn btn-danger btn-lg btn-block">
                🚪 Cerrar Sesión
            </a>
        </div>
    </div>
</div>

<style>
    .menu-item {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
        background: white;
        color: #333;
    }

        .menu-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            color: #667eea;
        }

        .menu-item .card-title {
            color: #333;
            font-weight: bold;
        }
</style>